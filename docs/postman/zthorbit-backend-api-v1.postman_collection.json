            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teammate+{{$timestamp}}@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"viewer\",\n  \"name\": \"Teammate\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
