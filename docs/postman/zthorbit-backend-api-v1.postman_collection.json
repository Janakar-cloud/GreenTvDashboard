                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "const id = pm.response.json()._id; if (id) { pm.environment.set('lastUserId', id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete user (admin/superadmin)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/{{lastUserId}}",
              "host": [
                "{{baseUrl}}"
