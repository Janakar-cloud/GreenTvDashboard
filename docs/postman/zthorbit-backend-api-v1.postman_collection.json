          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/media/{{lastMediaId}}", "host": ["{{baseUrl}}"], "path": ["media", "{{lastMediaId}}"] },
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{accessToken}}", "type": "string" } ] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204 or 403/404', function () { pm.expect([204,403,404]).to.include(pm.response.code); });"
          ] } } ]
